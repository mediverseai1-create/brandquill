# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used by the payment webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Payments (Stripe Payment Links supplied by you) ---
NEXT_PUBLIC_PAYMENT_LINK_PRO_MONTHLY=
NEXT_PUBLIC_PAYMENT_LINK_PRO_YEARLY=
# Stripe webhook signing secret (whsec_...) for POST /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe customer portal link for managing/cancelling
NEXT_PUBLIC_BILLING_PORTAL_URL=

# --- Contact ---
NEXT_PUBLIC_SALES_EMAIL=
