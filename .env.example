# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used by the payment webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Production URL. Used for email confirmation / password reset links. Do NOT use localhost on Vercel.
NEXT_PUBLIC_SITE_URL=https://brandquill.vercel.app

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Payments (Stripe Payment Links supplied by you) ---
NEXT_PUBLIC_PAYMENT_LINK_PRO=https://selar.com/57plan?currency=USD
NEXT_PUBLIC_PAYMENT_LINK_BUSINESS=https://selar.com/97plan?currency=USD
# Stripe payment link id (plink_...) of the Business link, so the webhook activates the right plan
STRIPE_BUSINESS_PAYMENT_LINK_ID=
# Stripe webhook signing secret (whsec_...) for POST /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe customer portal link for managing/cancelling
NEXT_PUBLIC_BILLING_PORTAL_URL=

